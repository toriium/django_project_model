# Cloudflare Tunnel: uncomment this block and change "localhost {" to ":80 {"
# (Cloudflare terminates HTTPS; cloudflared reaches Caddy over the internal network)
# {
# 	servers {
# 		trusted_proxies static private_ranges # trusts cloudflared (internal network) and keeps its X-Forwarded-Proto
# 		client_ip_headers CF-Connecting-IP # real client IP sent by Cloudflare
# 	}
# }

localhost {
	handle /static/* {
		uri strip_prefix /static
		root * /app/staticfiles
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {client_ip} # always overwritten by Caddy, so clients can't spoof it
		}
	}
}
